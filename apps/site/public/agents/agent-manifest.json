{
  "brand": "Greenleaf Market shopping assistant",
  "networks": [
    {
      "name": "market_assistant",
      "front_man": "assistant",
      "hocon": "./market_assistant.network.json",
      "description": "Recipe to cart (demo store)",
      "tags": [
        "deployed",
        "nsdeploy"
      ],
      "sample_queries": [
        "I want to make spaghetti carbonara for 4. Get me everything I need.",
        "Here's my recipe: 400 g spaghetti, 150 g pancetta, 4 eggs, 100 g pecorino, black pepper. Fill my cart."
      ]
    }
  ],
  "llm_router": {
    "base_url": "https://greenleaf-market.vercel.app/api/infer/v1",
    "mock": false,
    "site_funded": true,
    "byok_router": "",
    "note": "Publisher-funded default router for this site's own runtime. Informational for peers: a caller always uses its own router."
  },
  "allowed_peers": [
    "https://greenleaf-market.vercel.app/agents"
  ],
  "peer_policy": {
    "mode": "open",
    "deny_origins": [],
    "note": "Public agent sites are reachable like web pages; credentials and capabilities do not transfer."
  },
  "agent_mcp": {
    "protocol": "nsdeploy-agent-mcp/v1",
    "network": "market_assistant",
    "front_man": "assistant",
    "available": false,
    "reason": "This is a static bundle; a public MCP facade requires an application host."
  },
  "theme": {
    "primary": "#15803d"
  },
  "linking": {
    "protocol": "nsdeploy-link/v1",
    "exports": [
      {
        "network": "market_assistant",
        "front_man": "assistant",
        "aliases": [
          "market_assistant",
          "assistant"
        ],
        "url": "https://greenleaf-market.vercel.app/agents/market_assistant"
      }
    ],
    "imports": [],
    "site": "https://greenleaf-market.vercel.app/agents",
    "link_updates": {
      "mode": "browser-local"
    }
  },
  "deployment": {
    "mode": "static",
    "self_contained_runtime": true,
    "browser_mock": false,
    "direct_byok": false,
    "direct_mcp_requires_cors": true,
    "public_mcp_facade": false,
    "site_funded_inference": true
  },
  "actions": {
    "version": 1,
    "bridge": "./action-bridge.html",
    "module": "./actions.js"
  },
  "mcp": [
    {
      "url": "https://greenleaf-market.vercel.app/api/mcp/public",
      "tools": [
        "match_ingredients",
        "search_products"
      ],
      "auth": "none",
      "effect": "read"
    }
  ]
}
