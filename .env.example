# Server-side settings for apps/site (set them in Vercel → Project → Settings →
# Environment Variables; mark the key as Sensitive). Never commit real values.

# Site-funded default inference (spec §4). OpenAI-compatible provider.
INFERENCE_BASE_URL=https://api.openai.com/v1
INFERENCE_API_KEY=
# The server picks the model; the network's model_name is only a hint.
INFERENCE_MODEL=gpt-4o-mini
# Output cap per model call (max 4096).
INFERENCE_MAX_TOKENS=1024
INFERENCE_TIMEOUT_MS=55000
# Optional provider-specific options merged into each request (JSON object). Cannot
# override model, messages, tools or the token cap. Example for OpenRouter reasoning models:
# INFERENCE_EXTRA_BODY={"reasoning":{"effort":"low","exclude":true}}
INFERENCE_EXTRA_BODY=
# Kill switch: set to 1 to stop all site-funded model calls.
INFERENCE_DISABLED=0
